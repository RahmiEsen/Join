generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String?
  name             String?
  firstName        String?
  lastName         String?
  picture          String?
  background       String?
  provider         String?
  googleId         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  role             String    @default("user")
  contacts         Contact[]
  tasks            Task[]
  labels           Label[]
  taskLists        TaskList[]
  @@map("User")
}

model Contact {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phoneNumber String?
  isGuest     Boolean  @default(false)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  color       String?
  profilePicture String?
  tasks       Task[]
}

model TaskList {
  id          String @id @default(uuid())
  title       String
  createdAt   DateTime @default(now())
  tasks       Task[]
  order       Float    @default(0)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  isGuest   Boolean  @default(false)
}

model Task {
  id          String   @id @default(uuid())
  description String?
  title       String?
  coverColor  String?
  coverImage  String?
  attachments Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startDate   DateTime? 
  dueDate     DateTime?
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id])
  isGuest     Boolean  @default(false)
  labels      Label[]
  checklists  Checklist[]
  members     Contact[]
  taskList    TaskList?  @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  taskListId   String? 
  order       Float      @default(0)
}

model Label {
  id      String @id @default(uuid())
  title   String
  color   String
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isGuest Boolean @default(false)
  tasks   Task[]
  @@unique([ownerId, title])
}

model Checklist {
  id    String @id @default(uuid())
  title String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  items ChecklistItem[]
}

model ChecklistItem {
  id          String  @id @default(uuid())
  text        String
  isCompleted Boolean @default(false)
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String
}